# Local-only Claude / dev tooling
.claude/
.git/
.github/

# Node
**/node_modules/
client/dist/
client/.vite/

# Ruby
server/.bundle/
server/log/*
!server/log/.keep
server/tmp/*
!server/tmp/.keep
server/storage/*
!server/storage/.keep
server/spec/fixtures/files/

# Secrets that must never end up in a layer. master.key is supplied at
# runtime via RAILS_MASTER_KEY; .env* are local-only.
server/config/master.key
server/config/credentials/*.key
server/.env*

# OS / editor
**/.DS_Store
**/*.swp
