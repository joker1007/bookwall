<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Launcher/window theme; the UI itself is drawn by Compose Material 3. -->
    <style name="Theme.Bookwall" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- Readium's EPUB navigator inflates AppCompat-themed views, so its host
         activity needs an AppCompat theme. -->
    <style name="Theme.Bookwall.Epub" parent="Theme.AppCompat.DayNight.NoActionBar" />
</resources>
