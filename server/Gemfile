# frozen_string_literal: true

source "https://rubygems.org"

gem "rails", "~> 8.1.3"

# Database
gem "sqlite3", ">= 2.1"

# Web server (async, fiber-based)
gem "falcon"

# HTTP/2 + asset caching + X-Sendfile fronting proxy used in the Docker
# image (./bin/thrust → falcon).
gem "thruster", require: false

# Authentication
gem "bcrypt", "~> 3.1.7"

# Database-backed adapters for Rails.cache, Active Job, and Action Cable
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"

# JSON API serialization
gem "alba"

# Pagination (used for API responses and OPDS rel="next"/"prev")
gem "pagy"

# CORS for separate frontend (Vite + React in client/)
gem "rack-cors"

# E-book format parsers
gem "rubyzip", require: "zip"
gem "gepub"
gem "hexapdf"

# Image processing for cover thumbnails
gem "image_processing", "~> 1.2"
gem "ruby-vips"

# XML / HTML parsing (also used for OPDS feed builder)
gem "nokogiri"

# Content-Encoding negotiation for OPDS feeds (gzip is stdlib Zlib).
gem "brotli"
gem "zstd-ruby", require: "zstd-ruby"

# Exponential-backoff retry wrapper used by the library scanner to ride out
# SQLite BUSY contention with the web process.
gem "retriable"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

group :development, :test do
  gem "rspec-rails", "~> 8.0"
  gem "factory_bot_rails"
  gem "faker"
  gem "shoulda-matchers"
  gem "rails-controller-testing"

  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Audits gems for known security defects
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities
  gem "brakeman", require: false

  # Ruby style
  gem "rubocop-rails-omakase", require: false
end
